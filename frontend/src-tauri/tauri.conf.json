{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Idenva",
  "version": "0.1.0",
  "identifier": "com.idenva.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:18492",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/idenva-backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": [
          "fr-FR",
          "en-US"
        ]
      },
      "nsis": {
        "languages": [
          "French",
          "English"
        ]
      }
    }
  }
}